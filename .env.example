# music-rag 環境変数の雛形。cp .env.example .env して値を記入する。

# 必須: NVIDIA Build APIキー（生成層で使用。build.nvidia.com で発行）
NVIDIA_API_KEY=

# 必須: Gemini API キー（RAGAS評価層〈judge・embeddings〉専用。
# 本番の検索・生成フローには不要）
GEMINI_API_KEY=

# リモート埋め込み用（EMBED_BACKEND=deepinfra 時に必須。deepinfra.com で発行。
# 同一モデル BAAI/bge-m3 をホストしており localコーパスとベクトル空間が一致）
DEEPINFRA_API_KEY=

# Qdrant（ローカルDockerの既定値。managed Qdrant利用時は URL と API キーを設定）
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Qdrant Cloud へのコピー先（scripts/copy_collection.py 用。URL は :6333 なしのhttps）
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=

# 任意: 既定値を上書きする場合のみ
# NVIDIA_LLM_MODEL=meta/llama-3.3-70b-instruct    # 生成層（NVIDIA Build カタログのモデルID）
# GEMINI_MODEL=gemini-3.1-flash-lite               # RAGAS judge
# RAGAS_JUDGE_MODEL=gemini-3.1-flash-lite          # RAGAS judge（GEMINI_MODELと別で上書きしたい場合）
# RAGAS_SLEEP_SEC=15              # RAGAS評価の質問間ウェイト（秒）
# EMBED_BACKEND=local             # local | deepinfra | nvidia（デプロイ時は deepinfra）
# CHUNK_STRATEGY=structure        # structure | fixed（A/B比較用）
# MUSIC_RAG_DATA_DIR=data         # データディレクトリ（既定はcwd基準の ./data）
# ENABLE_URL_INPUT=true           # 音声URL入力（ローカル限定機能。公開デプロイ時は false）
# MAX_AUDIO_DURATION_SEC=600      # URL入力で受け付ける動画長の上限（秒）
